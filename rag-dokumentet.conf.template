# nginx for the service rag-dokumentet (docker-compose.dokploy.yaml): the
# assistant's documents page and document API only. ${RAG_API_URL} is filled
# in from the environment when the container starts.
server {
    listen 80;
    server_tokens off;

    # PDFs up to RAG_DOCUMENT_MAX_MB (100 MB) of the assistant.
    client_max_body_size 110m;
    proxy_request_buffering off;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

    location = /admin { proxy_pass ${RAG_API_URL}; }
    location /admin/ { proxy_pass ${RAG_API_URL}; }
    location = /documents { proxy_pass ${RAG_API_URL}; }
    location /documents/ { proxy_pass ${RAG_API_URL}; }

    location / { return 404; }
}
